{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccountName": {
      "value": "${{ values.name }}"
    },
    "location": {
      "value": "${{ values.location }}"
    },
    "accountTier": {
      "value": "${{ values.accountTier }}"
    },
    "replication": {
      "value": "${{ values.replication }}"
    },
    "enableHttpsOnly": {
      "value": ${{ values.enableHttpsOnly }}
    },
    "allowBlobPublicAccess": {
      "value": ${{ values.allowBlobPublicAccess }}
    }
  }
}