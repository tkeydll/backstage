{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "value": "${{ values.name }}"
    },
    "appServicePlanName": {
      "value": "${{ values.name }}-plan"
    },
    "location": {
      "value": "${{ values.location }}"
    },
    "sku": {
      "value": "${{ values.appServicePlanTier }}"
    },
    "enableApplicationInsights": {
      "value": ${{ values.enableApplicationInsights }}
    }
  }
}